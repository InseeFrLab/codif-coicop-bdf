# Byte-compiled / optimized Python files
__pycache__/
*.py[codz]
*$py.class

# Environments / virtualenvs
.venv/
env/
venv/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
*.egg

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Logs / sorties locales
*.log
report.txt
reports.txt

# Artefacts MLflow produits en local (un `mlflow.log_artifact` sans serveur
# distant configuré écrit dans ./mlruns). Les modèles et leurs artefacts —
# rules.json, threshold_sweep.json, rules_printed.txt… — vivent dans MLflow,
# jamais dans le dépôt : ils sont produits par une exécution, versionnés par
# leur run_id, et référencés par une URI (cf. `sirus-model-uri`).
# À ne pas confondre avec reconcile-sirus/tests/golden/, qui contient des FIXTURES de
# test, volontairement versionnées : sans elles le test d'équivalence
# Python ↔ sirus.predict ne peut pas tourner (le dépôt n'a pas de CI R).
mlruns/
mlflow.db

# Artefacts d'un entraînement SIRUS lancé à la main (`reconcile-sirus/train.sh`) : table
# de features, rules.json, mesures. Ils sont conservés en local uniquement pour
# permettre de relancer la 3ᵉ étape (`finalize`) sans réajuster le modèle ; la
# version qui compte part dans MLflow.
reconcile-sirus/artifacts/
